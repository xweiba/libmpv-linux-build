#!/bin/sh
set -e
export LC_ALL=C

#scripts/fribidi-config
#scripts/fribidi-build "$@"
scripts/bzip2-config
scripts/bzip2-build "$@"
scripts/uchardet-config
scripts/uchardet-build "$@"
scripts/libxpresent-config
scripts/libxpresent-build "$@"
scripts/rubberband-config
scripts/rubberband-build "$@"
scripts/libdisplay-info-config
scripts/libdisplay-info-build "$@"
scripts/libplacebo-config
scripts/libplacebo-build "$@"
scripts/libass-config
scripts/libass-build "$@"
scripts/dav1d-config
scripts/dav1d-build "$@"
scripts/libxml2-config
scripts/libxml2-build "$@"
scripts/ffmpeg-config
scripts/ffmpeg-build "$@"
# Keep the static libxml2 (DASH) private to libmpv.so: never interpose the
# host's libxml2 used by other libraries such as libarchive.
LDFLAGS="$LDFLAGS -Wl,--exclude-libs,libxml2.a" scripts/mpv-config
scripts/mpv-build "$@"
python3 "${GITHUB_WORKSPACE}/tests/audio_filters.py" mpv/build/libmpv.so.2
